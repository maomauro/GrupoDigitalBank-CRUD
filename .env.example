# Copiar a .env y ajustar. Nunca versionar .env
POSTGRES_DB=usuarios_db

# Propietario de la base y usuario que ejecuta las migraciones (superusuario del contenedor).
# La aplicacion NO lo usa.
POSTGRES_USER=usuarios_admin
POSTGRES_PASSWORD=cambiar_esta_clave_admin

# Rol de la aplicacion: solo puede ejecutar fn_usuario_crud (ver db/002_rol_aplicacion.sql).
# Debe ser distinto de POSTGRES_USER. El migrador lo crea con esta contrasena.
APP_DB_USER=usuarios_app
APP_DB_PASSWORD=cambiar_esta_clave_app

# Dominio publico que apunta al VPS (Caddy emite el certificado HTTPS automaticamente)
DOMINIO=usuarios.midominio.com
