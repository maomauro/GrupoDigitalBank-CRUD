# Copiar a .env y ajustar. Nunca versionar .env
POSTGRES_DB=usuarios_db

# Propietario de la base y usuario que ejecuta las migraciones (superusuario del contenedor).
# La aplicacion NO lo usa.
POSTGRES_USER=usuarios_admin
POSTGRES_PASSWORD=cambiar_esta_clave_admin

# Rol de la aplicacion: solo puede ejecutar fn_usuario_crud (ver db/002_rol_aplicacion.sql).
# Debe ser distinto de POSTGRES_USER. El migrador lo crea con esta contrasena.
APP_DB_USER=usuarios_app
APP_DB_PASSWORD=cambiar_esta_clave_app

# Dominio publico que apunta al VPS (Caddy emite el certificado HTTPS automaticamente)
DOMINIO=usuarios.midominio.com

# Acceso a la web (Basic Auth en Caddy, ver Caddyfile). La clave en claro NO se guarda:
# genere el hash con  scripts/generar-hash-auth.ps1 -ActualizarEnv  y pegue/guarde aqui solo el hash.
# El hash va entre comillas simples (Compose no interpola los '$' en ese caso).
# Este valor de ejemplo NO es un hash valido a proposito: el proxy no arranca hasta que lo reemplace.
AUTH_USUARIO=admin
AUTH_HASH='GENERAR-CON-scripts/generar-hash-auth.ps1'

# HSTS (Strict-Transport-Security) en segundos. Por omision 31536000 (1 ano) en produccion; no hace falta definirlo.
# El compose de desarrollo lo fuerza a 0. Para un primer despliegue prudente se puede bajar (p. ej. 300).
# HSTS_MAX_AGE=31536000
