@model UsuarioViewModel

<partial name="_ResumenErrores" />
<input type="hidden" asp-for="Id" />

<div class="campo">
    <label asp-for="Nombre"></label>
    <input asp-for="Nombre" maxlength="100" class="solo-mayusculas" autocomplete="off" />
    <span asp-validation-for="Nombre" class="msg-error"></span>
</div>
<div class="campo">
    <label asp-for="FechaNacimiento"></label>
    <input asp-for="FechaNacimiento" type="date" data-edad-destino="edad-calculada" />
    <span id="edad-calculada" class="edad-calculada" role="status" aria-live="polite" hidden></span>
    <span asp-validation-for="FechaNacimiento" class="msg-error"></span>
</div>
<div class="campo">
    <label asp-for="Sexo"></label>
    <select asp-for="Sexo">
        <option value="">Seleccione...</option>
        <option value="M">Masculino</option>
        <option value="F">Femenino</option>
    </select>
    <span asp-validation-for="Sexo" class="msg-error"></span>
</div>
