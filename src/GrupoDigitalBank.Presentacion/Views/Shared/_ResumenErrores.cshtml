@* Avisos de error del modelo. Reemplaza a asp-validation-summary: ese helper siempre emite un <div> y un
   <li style="display:none"> (para la validacion en el cliente, que aqui no se usa) y el atributo style en
   linea lo bloquea la politica de contenido (CSP) del proxy. Aqui solo se dibuja algo si hay errores. *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alerta error" role="alert">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
