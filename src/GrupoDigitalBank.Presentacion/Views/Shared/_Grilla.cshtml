@model PaginaViewModel
@{
    // A donde apuntan los enlaces de paginacion: por omision la pagina "Usuarios/Consultar"; el inicio con sesion los lleva a si mismo
    var destinoControlador = ViewData["DestinoControlador"] as string ?? "Usuarios";
    var destinoAccion = ViewData["DestinoAccion"] as string ?? "Consultar";
}

@if (Model.Usuarios.Count == 0)
{
    <p>No hay usuarios registrados. <a asp-controller="Usuarios" asp-action="Registrar">Registrar el primero</a>.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Id</th><th>Nombre</th><th>Fecha de nacimiento</th><th>Sexo</th><th>Acciones</th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Usuarios)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Nombre</td>
                <td>@u.FechaNacimiento?.ToString("yyyy-MM-dd")</td>
                <td>@u.SexoTexto</td>
                <td class="acciones">
                    <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@u.Id">Modificar</a>
                    @* Eliminar vuelve a esta misma pagina y tamano *@
                    <form asp-controller="Usuarios" asp-action="Eliminar" asp-route-id="@u.Id" asp-route-pagina="@Model.Pagina" asp-route-tamano="@Model.Tamano" method="post"
                          data-confirmar="¿Eliminar a @u.Nombre?">
                        <button type="submit" class="peligro">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <nav class="paginacion" aria-label="Paginación">
        <span>Página @Model.Pagina de @Model.TotalPaginas · @Model.TextoTotal</span>
        @if (Model.HayAnterior)
        {
            <a asp-controller="@destinoControlador" asp-action="@destinoAccion" asp-route-pagina="@(Model.Pagina - 1)" asp-route-tamano="@Model.Tamano" rel="prev">Anterior</a>
        }
        else
        {
            <span class="deshabilitado">Anterior</span>
        }
        @if (Model.HaySiguiente)
        {
            <a asp-controller="@destinoControlador" asp-action="@destinoAccion" asp-route-pagina="@(Model.Pagina + 1)" asp-route-tamano="@Model.Tamano" rel="next">Siguiente</a>
        }
        else
        {
            <span class="deshabilitado">Siguiente</span>
        }
        <span class="tamanos">Por página:
            @foreach (var t in PaginaViewModel.Tamanos)
            {
                if (t == Model.Tamano)
                {
                    <strong>@t</strong>
                }
                else
                {
                    <a asp-controller="@destinoControlador" asp-action="@destinoAccion" asp-route-pagina="1" asp-route-tamano="@t">@t</a>
                }
            }
        </span>
    </nav>
}
