<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gestión de usuarios</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/js/site.js" defer></script>
</head>
<body>
    @{
        // "/" y "/salir" son las unicas paginas publicas (sin sesion); todo lo demas esta detras del usuario y clave del proxy
        var controlador = ViewContext.RouteData.Values["controller"] as string;
        var accion = ViewContext.RouteData.Values["action"] as string;
        var conSesion = !(string.Equals(controlador, "Inicio", StringComparison.OrdinalIgnoreCase)
            && (string.Equals(accion, "Index", StringComparison.OrdinalIgnoreCase) || string.Equals(accion, "Salir", StringComparison.OrdinalIgnoreCase)));
    }
    <header>
        @* El titulo abre la explicacion completa de la solucion: publica ("/") sin sesion y protegida ("/acerca") con sesion *@
        <a class="marca" asp-controller="Inicio" asp-action="@(conSesion ? "Acerca" : "Index")">
            <strong>Grupo Digital Bank</strong>
            <span class="app">Gestión de usuarios</span>
        </a>
        @if (conSesion)
        {
            <nav>
                <a asp-controller="Inicio" asp-action="Panel">Inicio</a>
            </nav>
            <a class="salir" asp-controller="Inicio" asp-action="Salir">Cerrar sesión</a>
        }
        else
        {
            <a class="iniciar" asp-controller="Inicio" asp-action="Panel">Iniciar sesión</a>
        }
    </header>
    <main>
        @if (TempData["Mensaje"] is string mensaje) { <div class="alerta ok">@mensaje</div> }
        @if (TempData["Error"] is string error) { <div class="alerta error">@error</div> }
        @RenderBody()
    </main>
</body>
</html>
