<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gestión de usuarios</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/js/site.js" defer></script>
</head>
<body>
    <header>
        <strong>Gestión de usuarios</strong>
        <nav>
            <a asp-controller="Inicio" asp-action="Index">Inicio</a>
            <a asp-controller="Usuarios" asp-action="Registrar">Registrar</a>
            <a asp-controller="Usuarios" asp-action="Consultar">Consultar</a>
        </nav>
        <a class="salir" asp-controller="Inicio" asp-action="Salir">Cerrar sesión</a>
    </header>
    <main>
        @if (TempData["Mensaje"] is string mensaje) { <div class="alerta ok">@mensaje</div> }
        @if (TempData["Error"] is string error) { <div class="alerta error">@error</div> }
        @RenderBody()
    </main>
</body>
</html>
