@model string
@* Iconos SVG en linea (sin style=, permitido por la CSP); decorativos: el nombre accesible lo da el boton o enlace que los contiene *@
<svg class="icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
@switch (Model)
{
    case "editar":
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
        break;
    case "eliminar":
        <path d="M3 6h18" />
        <path d="M8 6V4h8v2" />
        <path d="M19 6l-1 14H6L5 6" />
        <path d="M10 11v6M14 11v6" />
        break;
    case "nuevo":
        <path d="M12 5v14M5 12h14" />
        break;
}
</svg>
