<svg class="diagrama" viewBox="0 0 1000 690" role="img" aria-labelledby="t-inf d-inf" xmlns="http://www.w3.org/2000/svg">
    <title id="t-inf">Infraestructura de producción</title>
    <desc id="d-inf">El navegador llega por Cloudflare a un gateway nginx en un servidor propio; el gateway reparte a los proyectos por una red compartida. GitHub Actions publica imágenes en GHCR y despliega por SSH. Las copias van cifradas a Backblaze B2 y el servicio se vigila con UptimeRobot y Healthchecks.</desc>
    <defs>
        <marker id="punta-inf" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" class="punta" />
        </marker>
    </defs>

    <!-- Entrega: GitHub y GHCR -->
    <rect x="20" y="60" width="270" height="78" rx="8" class="caja-ext" />
    <text x="155" y="88" class="t t-centro t-fuerte">GitHub</text>
    <text x="155" y="108" class="t t-centro t-peq">código · Pull Requests · CI</text>
    <text x="155" y="124" class="t t-centro t-peq">GitHub Actions (CI/CD)</text>
    <line x1="155" y1="138" x2="155" y2="172" class="flecha" marker-end="url(#punta-inf)" />
    <rect x="20" y="172" width="270" height="56" rx="8" class="caja-ext" />
    <text x="155" y="196" class="t t-centro t-fuerte">GHCR</text>
    <text x="155" y="214" class="t t-centro t-peq">imágenes versionadas de la aplicación</text>
    <text x="20" y="252" class="t t-peq">Entrega: SSH con llave restringida a una</text>
    <text x="20" y="268" class="t t-peq">sola orden; el servidor valida el paquete</text>
    <text x="20" y="284" class="t t-peq">y vuelve atrás solo si algo falla.</text>

    <!-- Visitante, Cloudflare y gateway -->
    <rect x="20" y="360" width="120" height="64" rx="8" class="caja-ext" />
    <text x="80" y="388" class="t t-centro t-fuerte">Navegador</text>
    <text x="80" y="406" class="t t-centro t-peq">revisor</text>
    <line x1="140" y1="392" x2="168" y2="392" class="flecha" marker-end="url(#punta-inf)" />
    <rect x="168" y="346" width="136" height="92" rx="8" class="caja-ext" />
    <text x="236" y="372" class="t t-centro t-fuerte">Cloudflare</text>
    <text x="236" y="391" class="t t-centro t-peq">DNS · proxy · TLS</text>
    <text x="236" y="407" class="t t-centro t-peq">certificado de cliente</text>
    <text x="236" y="423" class="t t-centro t-peq">(mTLS) hacia el origen</text>
    <line x1="304" y1="392" x2="352" y2="392" class="flecha" marker-end="url(#punta-inf)" />

    <!-- Servidor -->
    <rect x="336" y="56" width="650" height="520" rx="12" class="servidor" />
    <text x="354" y="82" class="t t-fuerte">Servidor propio (VPS) · Docker</text>

    <rect x="352" y="346" width="132" height="92" rx="8" class="caja-capa-inf" />
    <text x="418" y="372" class="t t-centro t-fuerte">Gateway</text>
    <text x="418" y="391" class="t t-centro t-peq">nginx · único con</text>
    <text x="418" y="407" class="t t-centro t-peq">el puerto 443; solo</text>
    <text x="418" y="423" class="t t-centro t-peq">acepta a Cloudflare</text>

    <rect x="504" y="100" width="466" height="346" rx="10" class="red" />
    <text x="520" y="122" class="t t-peq t-fuerte">red compartida de entrada</text>

    <rect x="522" y="134" width="430" height="168" rx="8" class="proyecto" />
    <text x="538" y="156" class="t t-fuerte">Este proyecto · gdb-crud</text>
    <text x="938" y="156" class="t t-peq t-der">red privada: no publica puertos</text>
    <rect x="538" y="172" width="94" height="66" rx="6" class="caja" />
    <text x="585" y="196" class="t t-centro t-fuerte">Caddy</text>
    <text x="585" y="214" class="t t-centro t-peq">usuario y clave</text>
    <text x="585" y="228" class="t t-centro t-peq">CSP · HSTS</text>
    <rect x="646" y="172" width="94" height="66" rx="6" class="caja" />
    <text x="693" y="196" class="t t-centro t-fuerte">web</text>
    <text x="693" y="214" class="t t-centro t-peq">ASP.NET Core</text>
    <text x="693" y="228" class="t t-centro t-peq">MVC</text>
    <rect x="754" y="172" width="94" height="66" rx="6" class="caja" />
    <text x="801" y="196" class="t t-centro t-fuerte">negocios</text>
    <text x="801" y="214" class="t t-centro t-peq">CoreWCF</text>
    <text x="801" y="228" class="t t-centro t-peq">SOAP</text>
    <rect x="862" y="172" width="80" height="66" rx="6" class="caja" />
    <text x="902" y="196" class="t t-centro t-fuerte">db</text>
    <text x="902" y="214" class="t t-centro t-peq">PostgreSQL</text>
    <text x="902" y="228" class="t t-centro t-peq">17</text>
    <line x1="632" y1="205" x2="646" y2="205" class="flecha" marker-end="url(#punta-inf)" />
    <line x1="740" y1="205" x2="754" y2="205" class="flecha" marker-end="url(#punta-inf)" />
    <line x1="848" y1="205" x2="862" y2="205" class="flecha" marker-end="url(#punta-inf)" />
    <text x="538" y="268" class="t t-peq">Despliegue con copia previa de la base y rollback</text>
    <text x="538" y="284" class="t t-peq">automático; sin puertos publicados en el host.</text>

    <rect x="522" y="324" width="206" height="62" rx="8" class="proyecto proyecto-otro" />
    <text x="625" y="350" class="t t-centro t-fuerte">PortalCV</text>
    <text x="625" y="368" class="t t-centro t-peq">otro proyecto, su propia red</text>
    <rect x="746" y="324" width="206" height="62" rx="8" class="proyecto proyecto-otro" />
    <text x="849" y="350" class="t t-centro t-fuerte">Colfe</text>
    <text x="849" y="368" class="t t-centro t-peq">otro proyecto, su propia red</text>
    <text x="522" y="412" class="t t-peq">El gateway es independiente: un fallo o un despliegue de</text>
    <text x="522" y="428" class="t t-peq">otro proyecto no tumba a este, y no alcanza sus bases de datos.</text>

    <line x1="484" y1="392" x2="514" y2="392" class="flecha" marker-end="url(#punta-inf)" />
    <line x1="514" y1="392" x2="514" y2="205" class="flecha" />
    <line x1="514" y1="205" x2="538" y2="205" class="flecha" marker-end="url(#punta-inf)" />

    <line x1="290" y1="200" x2="312" y2="200" class="flecha flecha-punteada" />
    <polyline points="312,200 312,252 522,252" class="flecha flecha-punteada" marker-end="url(#punta-inf)" />
    <text x="326" y="244" class="t t-peq t-fuerte">SSH</text>

    <!-- Operación -->
    <rect x="352" y="470" width="200" height="86" rx="8" class="caja-ext" />
    <text x="452" y="496" class="t t-centro t-fuerte">Copias de seguridad</text>
    <text x="452" y="514" class="t t-centro t-peq">diaria local · mensual externa</text>
    <text x="452" y="530" class="t t-centro t-peq">cifrada con age, restauración</text>
    <text x="452" y="546" class="t t-centro t-peq">probada de punta a punta</text>

    <rect x="352" y="610" width="200" height="64" rx="8" class="caja-ext" />
    <text x="452" y="636" class="t t-centro t-fuerte">Backblaze B2</text>
    <text x="452" y="654" class="t t-centro t-peq">almacén externo privado</text>
    <line x1="452" y1="556" x2="452" y2="610" class="flecha" marker-end="url(#punta-inf)" />

    <rect x="590" y="470" width="190" height="86" rx="8" class="caja-ext" />
    <text x="685" y="496" class="t t-centro t-fuerte">Alertas del servidor</text>
    <text x="685" y="514" class="t t-centro t-peq">cada día revisa copia,</text>
    <text x="685" y="530" class="t t-centro t-peq">disco y contenedores</text>
    <text x="685" y="546" class="t t-centro t-peq">y envía un latido</text>
    <line x1="685" y1="556" x2="685" y2="610" class="flecha" marker-end="url(#punta-inf)" />
    <rect x="590" y="610" width="190" height="64" rx="8" class="caja-ext" />
    <text x="685" y="636" class="t t-centro t-fuerte">Healthchecks.io</text>
    <text x="685" y="654" class="t t-centro t-peq">avisa por correo</text>

    <rect x="800" y="470" width="170" height="86" rx="8" class="caja-ext" />
    <text x="885" y="496" class="t t-centro t-fuerte">Monitoreo externo</text>
    <text x="885" y="514" class="t t-centro t-peq">consulta /health</text>
    <text x="885" y="530" class="t t-centro t-peq">cada 5 minutos</text>
    <line x1="885" y1="556" x2="885" y2="610" class="flecha" marker-end="url(#punta-inf)" />
    <rect x="800" y="610" width="170" height="64" rx="8" class="caja-ext" />
    <text x="885" y="636" class="t t-centro t-fuerte">UptimeRobot</text>
    <text x="885" y="654" class="t t-centro t-peq">avisa por correo</text>
</svg>
