{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Negocios (modo B)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/GrupoDigitalBank.Negocios/bin/Debug/net10.0/GrupoDigitalBank.Negocios.dll",
      "cwd": "${workspaceFolder}/src/GrupoDigitalBank.Negocios",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5081"
      },
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Presentacion (modo B)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/GrupoDigitalBank.Presentacion/bin/Debug/net10.0/GrupoDigitalBank.Presentacion.dll",
      "cwd": "${workspaceFolder}/src/GrupoDigitalBank.Presentacion",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)"
      },
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ],
  "compounds": [
    {
      "name": "Modo B: Negocios + Presentacion",
      "configurations": ["Negocios (modo B)", "Presentacion (modo B)"],
      "preLaunchTask": "bd: iniciar (modo B)",
      "stopAll": true
    }
  ]
}
