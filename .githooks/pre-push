#!/bin/sh
# Hook pre-push (decision D6). Se activa con:  git config core.hooksPath .githooks
#  1. Rechaza el push directo a main y develop (todo entra por Pull Request).
#  2. Ejecuta la verificacion rapida (format + build) antes de publicar ramas.
# Saltarlo (no recomendado): git push --no-verify

ZERO=0000000000000000000000000000000000000000
verificar=0

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/develop)
            echo "pre-push: push directo a '${remote_ref#refs/heads/}' rechazado." >&2
            echo "  Trabaja en una rama (feat/, fix/, chore/...) y abre un Pull Request." >&2
            echo "  Release: PR develop -> main con 'merge commit'. Ver docs/git-guia-tecnica.md" >&2
            exit 1
            ;;
    esac
    # Solo se verifica al publicar ramas (no al borrar ni al subir tags)
    case "$remote_ref" in
        refs/heads/*) [ "$local_sha" != "$ZERO" ] && verificar=1 ;;
    esac
done

if [ "$verificar" -eq 1 ]; then
    raiz=$(git rev-parse --show-toplevel)
    if command -v pwsh >/dev/null 2>&1; then ps=pwsh; else ps=powershell.exe; fi
    echo "pre-push: verificacion rapida (format whitespace + build)..."
    "$ps" -NoProfile -ExecutionPolicy Bypass -File "$raiz/scripts/verificar.ps1" -Rapido || {
        echo "pre-push: la verificacion fallo; push cancelado." >&2
        exit 1
    }
fi
exit 0
